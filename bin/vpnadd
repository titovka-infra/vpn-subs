#!/usr/bin/env bash
set -euo pipefail

USERS_CSV="users.csv"
SUBS_DIR="subs"
TEMPLATE_JSON="$SUBS_DIR/_template/sub.json"
VPNAPPLY_HOST="${VPNAPPLY_HOST:-edge1.titovka.com}"

die(){ echo "ERROR: $*" >&2; exit 1; }

ensure(){
  [ -f "$USERS_CSV" ] || die "$USERS_CSV не найден"
  header="$(python3 - <<'PY'
from pathlib import Path
p=Path("users.csv")
txt=p.read_text(encoding="utf-8-sig").splitlines()
print((txt[0] if txt else "").strip())
PY
)"
  [ "$header" = "id,name,status" ] || die "users.csv должен иметь заголовок: id,name,status"
  [ -d "$SUBS_DIR" ] || die "нет директории $SUBS_DIR"
  [ -f "$TEMPLATE_JSON" ] || die "нет шаблона $TEMPLATE_JSON"
}

list_users(){
python3 - <<'PY'
import csv
rows=[]
with open("users.csv","r",encoding="utf-8-sig",newline="") as f:
    r=csv.DictReader(f)
    for row in r:
        rows.append(((row["id"] or "").strip(),
                     (row["status"] or "").strip(),
                     (row["name"] or "").strip()))
rows.sort(key=lambda x:x[0])
print("ID   STATUS     NAME")
print("--------------------------")
for i,st,name in rows:
    print(f"{i:<4} {st:<10} {name}")
PY
}

next_id(){
python3 - <<'PY'
import csv
mx=0
with open("users.csv","r",encoding="utf-8-sig",newline="") as f:
    r=csv.DictReader(f)
    for row in r:
        i=(row.get("id") or "").strip()
        if i.isdigit() and len(i)==3:
            mx=max(mx,int(i))
print(f"{mx+1:03d}")
PY
}

# === UX: подсказка всегда печатается, значение возвращается ЧИСТО ===
status_prompt(){
  local current="${1:-active}"
  local def="1"
  [ "$current" = "disabled" ] && def="2"

  echo "Статус:" >&2
  echo "1) active" >&2
  echo "2) disabled" >&2
  read -r -p "Выбери номер (1-2) [по умолчанию $def]: " a >&2
  a="${a:-$def}"

  if [ "$a" = "2" ]; then
    echo "disabled"
  else
    echo "active"
  fi
}

gen_uuid(){ python3 - <<'PY'
import uuid; print(uuid.uuid4())
PY
}

create_sub_json(){
  local id="$1" uuid="$2"
  mkdir -p "$SUBS_DIR/$id"
  python3 - <<PY
import json
from pathlib import Path
tpl=Path("$TEMPLATE_JSON")
out=Path("$SUBS_DIR/$id/sub.json")
d=json.loads(tpl.read_text(encoding="utf-8"))
d["outbounds"][0]["settings"]["vnext"][0]["users"][0]["id"]="$uuid"
out.write_text(json.dumps(d,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print("OK: sub.json создан", out)
PY
}

create_user(){
  echo "=== Создать пользователя ==="
  id="$(next_id)"
  echo "Новый ID: $id"
  read -r -p "Введите имя: " name
  name="$(echo "$name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ -n "$name" ] || die "имя не может быть пустым"

  status="$(status_prompt active)"
  uuid="$(gen_uuid)"

  python3 - <<PY
import csv
rows=[]
with open("$USERS_CSV","r",encoding="utf-8-sig",newline="") as f:
    r=csv.DictReader(f)
    for row in r:
        rows.append(row)
rows.append({"id":"$id","name":"$name","status":"$status"})
with open("$USERS_CSV","w",encoding="utf-8",newline="") as f:
    w=csv.DictWriter(f,fieldnames=["id","name","status"])
    w.writeheader(); w.writerows(rows)
print("OK: users.csv обновлён")
PY

  create_sub_json "$id" "$uuid"
  echo "✅ Создан пользователь: $id — $name — $status"
  echo "UUID: $uuid"
}

after(){
  echo
  echo "ℹ️  Не забудь применить изменения:"
  echo "    ./bin/vpnapply $VPNAPPLY_HOST"
  echo
  echo "Что дальше?"
  echo "1) Главное меню"
  echo "2) Выход"
  read -r -p "Выбери номер (1-2): " a
  [ "$a" = "2" ] && return 1 || return 0
}

ensure
while true; do
  echo "=== VPN мастер ==="
  echo "1) Создать пользователя"
  echo "2) Редактировать пользователя"
  echo "3) Удалить пользователя"
  echo "4) Выход"
  read -r -p "Выбери номер (1-4): " c
  case "$c" in
    1) create_user; after || break ;;
    4) break ;;
    *) echo "Пока тестируем только создание";;
  esac
done
exit 0
